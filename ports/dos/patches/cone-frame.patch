+
+; one frame of the cone of cold (AnimateConeOfCold, EOB.EXE 0EF3:2EBC), in registers, the same pixels in the same order. Slot 34,
+; ds:80B2, which nothing else calls. ConeFrame(rows far, count, step, sum, frameTable far, useMask, erase) returns the new state
+ConeFrame	PROC	NEAR
+	push	bp
+	mov	bp, sp
+	sub	sp, 8
+	push	ds
+	push	si
+	push	di
+	lds	si, dword ptr cs:[gPageSegsPtr]
+	mov	ax, word ptr [si]
+	mov	word ptr [bp - 2], ax	; page 0
+	mov	ax, word ptr [si + 4]
+	mov	word ptr [bp - 4], ax	; page 2
+	mov	es, word ptr [bp - 2]
+	mov	ds, word ptr [bp + 8]
+	mov	ax, word ptr [bp + 0Ah]
+	mov	word ptr [bp - 6], ax
+	cmp	word ptr [bp + 16h], 0
+	je	CN_DrawStart
+	mov	di, word ptr [bp + 6]
+	dec	ax
+	shl	ax, 1
+	add	di, ax
+CN_Erase:
+	mov	ax, word ptr [di + 960h]
+	cmp	ax, 0FFFFh
+	je	CN_E9
+	shr	ax, 1
+	mov	si, ax
+	mov	dl, byte ptr [di + 4B0h]
+	and	dl, 0Fh
+	mov	dh, 0F0h
+	jc	CN_E2
+	shl	dl, 1
+	shl	dl, 1
+	shl	dl, 1
+	shl	dl, 1
+	mov	dh, 0Fh
+CN_E2:
+	mov	al, byte ptr es:[si]
+	and	al, dh
+	or	al, dl
+	mov	byte ptr es:[si], al
+CN_E9:
+	sub	di, 2
+	dec	word ptr [bp - 6]
+	jnz	CN_Erase
+	mov	ax, word ptr [bp + 0Ah]
+	mov	word ptr [bp - 6], ax
+CN_DrawStart:
+	mov	word ptr [bp - 8], 0
+	mov	di, word ptr [bp + 6]
+CN_Draw:
+	cmp	word ptr [di + 5DCh], 0	; a retired particle never draws again: nothing to move, save or restore
+	jne	CN_D0
+	mov	word ptr [di + 960h], 0FFFFh
+	jmp	near ptr CN_Next
+CN_D0:
+	mov	ax, word ptr [di + 834h]
+	or	ax, ax
+	jz	CN_Move
+	dec	ax
+	mov	word ptr [di + 834h], ax
+	jz	CN_Place
+	mov	word ptr [di + 960h], 0FFFFh	; still held: no pixel to save
+	xor	dx, dx
+	xor	cx, cx
+	jmp	near ptr CN_Stored
+CN_Move:
+	mov	bx, word ptr [bp + 0Ch]
+	mov	dx, word ptr [bp + 0Eh]
+	mov	si, word ptr [di + 258h]
+	cmp	word ptr [di], 0
+	jle	CN_M1
+	or	si, si
+	jle	CN_M2
+	sub	si, bx
+	jmp	short CN_M4
+CN_M2:
+	sub	si, dx
+	jmp	short CN_M4
+CN_M1:
+	or	si, si
+	jge	CN_M3
+	add	si, bx
+	jmp	short CN_M4
+CN_M3:
+	add	si, dx
+CN_M4:
+	mov	word ptr [di + 258h], si
+	mov	ax, word ptr [di + 384h]
+	cmp	word ptr [di + 12Ch], 0
+	jle	CN_M5
+	or	ax, ax
+	jle	CN_M6
+	sub	ax, bx
+	jmp	short CN_M8
+CN_M6:
+	sub	ax, dx
+	jmp	short CN_M8
+CN_M5:
+	or	ax, ax
+	jge	CN_M7
+	add	ax, bx
+	jmp	short CN_M8
+CN_M7:
+	add	ax, dx
+CN_M8:
+	mov	word ptr [di + 384h], ax
+	add	word ptr [di], si
+	add	word ptr [di + 12Ch], ax
+	mov	ax, word ptr [di + 5DCh]
+	add	word ptr [di + 708h], ax
+CN_Place:
+	mov	ax, word ptr [di]
+	sar	ax, 1
+	sar	ax, 1
+	sar	ax, 1
+	sar	ax, 1
+	sar	ax, 1
+	sar	ax, 1
+	add	ax, 58h
+	mov	bx, word ptr [di + 12Ch]
+	sar	bx, 1
+	sar	bx, 1
+	sar	bx, 1
+	sar	bx, 1
+	sar	bx, 1
+	sar	bx, 1
+	add	bx, 30h
+	xor	dx, dx
+	xor	cx, cx			; cl bit 0: right pixel, bit 1: on the screen
+	mov	word ptr [di + 960h], 0FFFFh
+	cmp	ax, 320
+	jae	CN_Stored
+	cmp	bx, 200
+	jae	CN_Stored
+	mov	cl, al
+	and	cl, 1
+	or	cl, 2
+	shl	bx, 1
+	mov	si, word ptr cs:[bx + gRowOffsets]
+	shr	ax, 1
+	add	si, ax
+	mov	ax, si
+	shl	ax, 1
+	or	al, cl
+	and	al, 0FDh		; bit 0: the right pixel; bit 1 was the on-screen flag
+	mov	word ptr [di + 960h], ax
+	cmp	word ptr [bp + 14h], 0
+	je	CN_NoMask
+	mov	es, word ptr [bp - 4]
+	mov	dl, byte ptr es:[si]
+	mov	es, word ptr [bp - 2]
+CN_NoMask:
+	mov	dh, byte ptr es:[si]
+	test	cl, 1
+	jnz	CN_Low
+	shr	dl, 1
+	shr	dl, 1
+	shr	dl, 1
+	shr	dl, 1
+	shr	dh, 1
+	shr	dh, 1
+	shr	dh, 1
+	shr	dh, 1
+	jmp	short CN_Stored
+CN_Low:
+	and	dx, 0F0Fh
+CN_Stored:
+	mov	byte ptr [di + 4B0h], dh
+	mov	byte ptr [di + 4B1h], 0
+	mov	al, byte ptr [di + 709h]
+	cbw
+	shl	ax, 1
+	mov	bx, ax
+	add	bx, word ptr [bp + 10h]
+	mov	es, word ptr [bp + 12h]
+	mov	ax, word ptr es:[bx]
+	mov	es, word ptr [bp - 2]
+	or	ax, ax
+	jnz	CN_Live
+	mov	word ptr [di + 5DCh], 0
+	jmp	short CN_Next
+CN_Live:
+	mov	word ptr [bp - 8], 1
+	or	dl, dl
+	jnz	CN_Next
+	cmp	word ptr [di + 834h], 0
+	jne	CN_Next
+	test	cl, 2
+	jz	CN_Next
+	and	al, 0Fh
+	mov	ah, 0F0h
+	test	cl, 1
+	jnz	CN_P1
+	shl	al, 1
+	shl	al, 1
+	shl	al, 1
+	shl	al, 1
+	mov	ah, 0Fh
+CN_P1:
+	mov	bl, byte ptr es:[si]
+	and	bl, ah
+	or	bl, al
+	mov	byte ptr es:[si], bl
+CN_Next:
+	add	di, 2
+	dec	word ptr [bp - 6]
+	jz	CN_Done
+	jmp	near ptr CN_Draw
+CN_Done:
+	mov	ax, word ptr [bp - 8]
+	pop	di
+	pop	si
+	pop	ds
+	mov	sp, bp
+	pop	bp
+	retf
+ConeFrame	ENDP
 
