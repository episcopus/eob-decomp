+; (port) DrawGlyph's fast loops. For the current text colours gGlyphWords holds, for each four glyph bits, the word of
+; four pixels they become; gNibbleHi and gNibbleLo give a byte's two nibbles as word indexes.
+gGlyphKey	dw	0FFFFh		; the colours gGlyphWords is built for: foreground in the high byte, background low
+gGlyphOpaque	db	0		; 1: clear bits draw the background; 0: clear bits keep the screen
+gGlyphWords	dw	16 dup (0)
+gNibbleHi LABEL BYTE
+NibbleIndex = 0
+	REPT	256
+	db	(NibbleIndex SHR 4) * 2
+NibbleIndex = NibbleIndex + 1
+	ENDM
+gNibbleLo LABEL BYTE
+NibbleIndex = 0
+	REPT	256
+	db	(NibbleIndex AND 0Fh) * 2
+NibbleIndex = NibbleIndex + 1
 	ENDM
+
+gIterWords	dw	18 dup (0)	; per glyph iteration: the mask of its first and second word, the mask byte
+gIterStep	dw	0		; the bytes bp moves over the iterations of a row
+
+; (near) From the mask bytes at cs:bp, one per iteration of a row, the masks in the words the iterations write; leaves
+; bp at gIterWords.
+GlyphMasks	PROC	NEAR
+	push	ax
+	push	bx
+	push	cx
+	push	si
+	mov	cx, word ptr cs:[gBlitBytes]
+	mov	ax, cx
+	shl	ax, 1
+	add	ax, cx
+	shl	ax, 1
+	mov	word ptr cs:[gIterStep], ax
+	inc	cx
+	mov	si, OFFSET gIterWords
+L_GM1:
+	mov	al, byte ptr cs:[bp]
+	inc	bp
+	xor	ah, ah
+	mov	word ptr cs:[si + 4], ax
+	mov	bx, ax
+	mov	bl, byte ptr cs:[bx + gNibbleHi]
+	xor	bh, bh
+	mov	bx, word ptr cs:[bx + gNibblePixels]
+	mov	word ptr cs:[si], bx
+	mov	bx, ax
+	mov	bl, byte ptr cs:[bx + gNibbleLo]
+	xor	bh, bh
+	mov	bx, word ptr cs:[bx + gNibblePixels]
+	mov	word ptr cs:[si + 2], bx
+	add	si, 6
+	loop	L_GM1
+	mov	bp, OFFSET gIterWords
+	pop	si
+	pop	cx
+	pop	bx
+	pop	ax
+	ret
+GlyphMasks	ENDP
 
