+; (port) NodeScan(struct Node far * far *head): DispatchNodeEvent's walk when nothing happened (no key, no mouse): the
+; first node at or after *head whose state bits differ from their previous values, left in *head (returns 1), or the
+; end of the walk (returns 0: the list ran out, or a node with state bit 2 and flag 20h stops it). The inactive nodes
+; are skipped. What the walk does at every other node has no effect (state and flags are written back unchanged).
+        PUBLIC  _NodeScan
+_NodeScan PROC FAR
+        push bp
+        mov bp, sp
+        les bx, dword ptr [bp+6]
+        les bx, dword ptr es:[bx]
+NS_loop:
+        test byte ptr es:[bx+0Eh], 8
+        jnz NS_next
+        mov ax, word ptr es:[bx+2Eh]
+        mov dx, ax
+        and dx, 9
+        jz NS_a
+        cmp dx, 9
+        jne NS_walk
+NS_a:
+        mov dx, ax
+        and dx, 14h
+        jz NS_b
+        cmp dx, 14h
+        jne NS_walk
+NS_b:
+        test al, 2
+        jz NS_next
+        test byte ptr es:[bx+0Eh], 20h
+        jnz NS_end
+NS_next:
+        les bx, dword ptr es:[bx]
+        mov ax, es
+        or ax, bx
+        jnz NS_loop
+NS_end:
+        xor ax, ax
+        pop bp
+        retf
+NS_walk:
+        mov ax, bx
+        mov dx, es
+        les bx, dword ptr [bp+6]
+        mov word ptr es:[bx], ax
+        mov word ptr es:[bx+2], dx
+        mov ax, 1
+        pop bp
+        retf
+_NodeScan ENDP
 
